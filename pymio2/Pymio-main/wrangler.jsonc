{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pymio-app",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.pymio.cl",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": ".cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "secrets": {
    "required": [
      "SUPABASE_URL",
      "SUPABASE_SECRET_KEY",
      "SESSION_SECRET",
      "PILOT_PASSWORD",
      "FRONTEND_ORIGINS"
    ]
  }
}
