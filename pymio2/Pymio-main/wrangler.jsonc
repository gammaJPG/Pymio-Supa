{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pymio-app",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-10-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": ".cloudflare-public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  }
}
